root = true

# 仓库字节现状（2026-11-12 全量扫描：git 已跟踪的文本文件 + 全部 .cs）：
#   手写 .cs：UTF-8 无 BOM + LF；例外是 Theme/ThemeText.cs、Theme/ToggleSwitch.cs、
#     Theme/ThemedListBox.cs，各含 1 行 CRLF（历史遗留，本任务不清洗）。
#   VS 生成文件：Properties/Resources.Designer.cs 为 BOM + CRLF（Settings.Designer.cs 已删除，[**/Properties/*.Designer.cs] 规则留给未来的生成文件）。
#   工程/解决方案：gostGUI/gostGUI.csproj 为 CRLF（无 BOM）；gostGUI.Runner/*.csproj 为 LF（无 BOM）；
#     gostGUI.sln 为 BOM + CRLF；gostGUI.slnx 为 CRLF（无 BOM）；两个 FodyWeavers.xml 均为 BOM，
#     UI 版为 LF、Runner 版为 CRLF。
# 所以这里按“实际字节”分节，而不是用一条全局 charset/EOL 覆盖所有文件；目标风格是
# UTF-8 无 BOM + LF，统一转码留给专门的规范化提交（本次不转，避免 format-on-save 把
# csproj/sln 整文件重写，给后续任务制造 EOL churn）。
[*]
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# 手写代码：UTF-8 无 BOM + LF（三个 Theme 文件里的单行 CRLF 是待清洗的例外）
[*.cs]
charset = utf-8
end_of_line = lf

# VS 生成的 Designer 文件保持生成器的 BOM + CRLF，避免每次重新生成都产生整文件 diff
[**/Properties/*.Designer.cs]
charset = utf-8-bom
end_of_line = crlf

# 工程/解决方案/配置文件当前 EOL 与编码不统一（见文件头），故此处不声明 charset/end_of_line：
# 目标是 LF + 无 BOM，统一转码留给专门的规范化提交；现在声明只会让 format-on-save
# 把 gostGUI.csproj / gostGUI.sln 整文件重写。
[*.{csproj,props,targets,config,xml,sln,slnx}]
indent_size = 2

# ---------------------------------------------------------------------------
# C# 代码风格
# ---------------------------------------------------------------------------
[*.cs]

# 命名空间：现有文件全部是块级命名空间；file-scoped 只是“新代码建议”，
# 不参与构建告警，所以不会引发全库重排。
csharp_style_namespace_declarations = file_scoped:suggestion

# var 偏好：代码里 var 与显式类型各占一半（254 处 var，246 处显式 new），
# 两种写法都保留为建议级，不作硬性要求。
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 与现有代码一致：字段/属性/方法/事件一律不写 this.（全库 0 处 this.，
# 仅 IDE 生成的 Designer 文件除外）。
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# 类型别名 vs BCL 类型名：现有代码混用（IntPtr/Int64 用于 P/Invoke 签名，int/string 用于业务代码），
# 保持建议级，不强制改 P/Invoke 签名。
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# 可读性偏好（建议级，避免对既有代码做无意义重排）
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:suggestion
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion

# 语言级写法：与现有代码一致（块体为主，单行才用表达式体），均为建议级。
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = false:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

# 换行与缩进（Allman 大括号，现有 4200 行的 FormMain.cs 也是这个写法）。
# 这些是格式化选项，不单独产生构建告警。
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false

# ---------------------------------------------------------------------------
# 命名规则（对照仓库现有写法核对后的实际约定）
#   私有实例字段：_camelCase          （_workDir / _disposed / _gate）
#   私有 static / const：PascalCase   （JsonOptions / RunnerStopTimeout / VkMenu）
#   公共/受保护成员、类型、方法、属性、事件：PascalCase
#   接口：I + PascalCase              （IThemed）
#   参数 / 局部变量：camelCase         （configItem / extendedInfoPtr）
# 规则按“通用 -> 特殊”排列（后定义的规则优先）：
# 全部设为 suggestion：现有 P/Invoke 结构体沿用 Win32 原生名（cb、nShow、hIconOrMonitor），
# 强制改会破坏互操作可读性，也会造成大面积无意义 diff。
dotnet_naming_rule.private_fields_rule.symbols = private_fields
dotnet_naming_rule.private_fields_rule.style = underscore_camel
dotnet_naming_rule.private_fields_rule.severity = suggestion

dotnet_naming_rule.private_static_fields_rule.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_rule.style = pascal
dotnet_naming_rule.private_static_fields_rule.severity = suggestion

dotnet_naming_rule.private_const_fields_rule.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_rule.style = pascal
dotnet_naming_rule.private_const_fields_rule.severity = suggestion

dotnet_naming_rule.const_fields_rule.symbols = const_fields
dotnet_naming_rule.const_fields_rule.style = pascal
dotnet_naming_rule.const_fields_rule.severity = suggestion

dotnet_naming_rule.public_fields_rule.symbols = public_fields
dotnet_naming_rule.public_fields_rule.style = pascal
dotnet_naming_rule.public_fields_rule.severity = suggestion

dotnet_naming_rule.interfaces_rule.symbols = interfaces
dotnet_naming_rule.interfaces_rule.style = i_pascal
dotnet_naming_rule.interfaces_rule.severity = suggestion

dotnet_naming_rule.types_rule.symbols = types
dotnet_naming_rule.types_rule.style = pascal
dotnet_naming_rule.types_rule.severity = suggestion

dotnet_naming_rule.methods_and_properties_rule.symbols = methods_and_properties
dotnet_naming_rule.methods_and_properties_rule.style = pascal
dotnet_naming_rule.methods_and_properties_rule.severity = suggestion

dotnet_naming_rule.events_rule.symbols = events
dotnet_naming_rule.events_rule.style = pascal
dotnet_naming_rule.events_rule.severity = suggestion

dotnet_naming_rule.parameters_rule.symbols = parameters
dotnet_naming_rule.parameters_rule.style = camel
dotnet_naming_rule.parameters_rule.severity = suggestion

dotnet_naming_rule.locals_rule.symbols = locals
dotnet_naming_rule.locals_rule.style = camel
dotnet_naming_rule.locals_rule.severity = suggestion

dotnet_naming_rule.type_parameters_rule.symbols = type_parameters
dotnet_naming_rule.type_parameters_rule.style = t_pascal
dotnet_naming_rule.type_parameters_rule.severity = suggestion

# 符号组
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.const_fields.required_modifiers = const

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public, protected, protected_internal, private_protected

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.methods_and_properties.applicable_kinds = method, property
dotnet_naming_symbols.methods_and_properties.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.events.applicable_kinds = event
dotnet_naming_symbols.events.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

# 命名风格
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.i_pascal.required_prefix = I
dotnet_naming_style.i_pascal.capitalization = pascal_case
dotnet_naming_style.t_pascal.required_prefix = T
dotnet_naming_style.t_pascal.capitalization = pascal_case
