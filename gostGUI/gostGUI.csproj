  <ItemGroup>
    <!-- 只建立“先构建 runner，再构建 UI”的顺序依赖：CopyRunnerToOutput 才能复制到最新 exe。
         ReferenceOutputAssembly=false + Private=false 表示不引用它的程序集、也不把它当依赖 dll 复制。 -->
    <ProjectReference Include="..\gostGUI.Runner\gostGUI.Runner.csproj">
      <Project>{DDB7BFEB-0141-4DC0-80CB-859C98E24906}</Project>
      <Name>gostGUI.Runner</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <!-- R24/R25/R26: copy the relay exe AND its exe.config into the UI output. The
       ProjectReference guarantees the runner is built first, so a missing runner output is a
       packaging regression: fail the build instead of silently skipping with Condition="Exists". -->
  <Target Name="CopyRunnerToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_RunnerOutputDir>$(MSBuildProjectDirectory)\..\gostGUI.Runner\bin\$(Configuration)\</_RunnerOutputDir>
      <_RunnerExePath>$(_RunnerOutputDir)gostGUI.Runner.exe</_RunnerExePath>
      <_RunnerConfigPath>$(_RunnerOutputDir)gostGUI.Runner.exe.config</_RunnerConfigPath>
    </PropertyGroup>
    <ItemGroup>
      <_RunnerArtifact Include="$(_RunnerExePath)" />
      <_RunnerArtifact Include="$(_RunnerConfigPath)" />
    </ItemGroup>
    <Error Condition="!Exists('$(_RunnerExePath)')" Text="打包失败：找不到中转进程 $(_RunnerExePath)。ProjectReference 必须先构建 gostGUI.Runner。" />
    <Error Condition="!Exists('$(_RunnerConfigPath)')" Text="打包失败：找不到中转进程配置 $(_RunnerConfigPath)。gostGUI.Runner 的 app.config 必须随 exe 一起产出。" />
    <Copy SourceFiles="@(_RunnerArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
